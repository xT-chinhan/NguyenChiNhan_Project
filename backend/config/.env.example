# Run python -m navcore.cli bootstrap-dev to create real local secrets.
NAV_ENV=development
NAV_API_URL=http://127.0.0.1:8095
POSTGRES_USER=navcore
POSTGRES_PASSWORD=<generated-by-bootstrap>
POSTGRES_DB=navcore
NAV_DB_URL=<generated-by-bootstrap>
NAV_TEST_DB_URL=<generated-by-bootstrap>
NAV_ADMIN_TOKEN=<generated-by-bootstrap>
NAV_MODEL_DIR=<absolute-path-to-backend-models>
NAV_VISION_DEVICE=cpu
NAV_LOG_LEVEL=DEBUG
NAV_HTTP_HOST=127.0.0.1
NAV_HTTP_PORT=8095
